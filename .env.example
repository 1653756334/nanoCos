# ==============================================================================
# NanoCOS 运行环境变量配置示例
# 复制本文件为 .env 即可生效：cp .env.example .env (Linux/macOS) 或 copy .env.example .env (Windows)
# 优先级顺序：命令行启动参数 > 系统环境变量 > .env 文件 > 默认值
# ==============================================================================

# HTTP 服务监听地址 (例如 :9000 或 127.0.0.1:9000)
NANOCOS_ADDR=:9000

# 数据持久化目录 (包含 SQLite 元数据、物理 CAS 数据块、临时分片)
NANOCOS_DATA_DIR=./data

# 首次建库或配合 -reset-admin 时的初始管理员账号 (默认: admin)
NANOCOS_ADMIN_USER=admin

# 首次建库或配合 -reset-admin 时的初始管理员密码
# 留空时，首次启动将自动生成 16 位随机强密码并在终端打印
NANOCOS_ADMIN_PASS=

# 首次初始化时是否在控制台打印明文密码与默认 SK (生产日志采集中可设为 false)
NANOCOS_PRINT_SECRET=true

# 对外基准访问 URL (例如 https://cos.example.com，留空则自动根据请求 Host 推断)
NANOCOS_PUBLIC_URL=

# S3 兼容协议默认区域 (默认: us-east-1)
NANOCOS_S3_REGION=us-east-1

# 单文件最大允许上传体积 (单位 GiB，默认: 50)
NANOCOS_MAX_UPLOAD_GB=50

# 是否信任反向代理转发的 X-Forwarded-For / X-Real-IP 请求头 (受控 Nginx/Caddy 后建议开启)
NANOCOS_TRUST_PROXY=false

# 是否跳过启动时的后台异步物理块全量对账与 GC 回收 (默认: false)
NANOCOS_SKIP_STARTUP_GC=false

# 日志输出级别: debug | info | warn | error (默认: info)
NANOCOS_LOG_LEVEL=info

# 日志输出格式: text | json (默认: text)
NANOCOS_LOG_FORMAT=text
