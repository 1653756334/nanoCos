[Unit]
Description=NanoCOS Lightweight Content-Addressable & S3-Compatible Object Storage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nanocos
Group=nanocos
WorkingDirectory=/var/lib/nanocos
# 可在 /etc/nanocos/nanocos.env (权限 0600) 中配置 NANOCOS_PUBLIC_URL 等环境变量，切勿在命令行参数中硬编码密码
EnvironmentFile=-/etc/nanocos/nanocos.env
ExecStart=/usr/local/bin/cosd -addr :9000 -data-dir /var/lib/nanocos/data -log-format json
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# systemd 安全沙箱加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/nanocos

[Install]
WantedBy=multi-user.target
