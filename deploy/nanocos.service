[Unit]
Description=NanoCOS Lightweight Content-Addressable & S3-Compatible Object Storage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nanocos
Group=nanocos
WorkingDirectory=/var/lib/nanocos
# 默认运行参数通过环境变量提供，可在 /etc/nanocos/nanocos.env (权限 0600) 中按需覆盖
Environment="NANOCOS_ADDR=:9000"
Environment="NANOCOS_DATA_DIR=/var/lib/nanocos/data"
Environment="NANOCOS_LOG_FORMAT=json"
EnvironmentFile=-/etc/nanocos/nanocos.env
ExecStart=/usr/local/bin/cosd
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# systemd 安全沙箱加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/nanocos

[Install]
WantedBy=multi-user.target
